const { execSync } = require('child_process');
const fs = require('fs');

try {
  // Run git diff on specific file and write tool output
  const diff = execSync('git diff -- "src/app/nutri/patient/[id]/menu/page.js"', { encoding: 'utf8' });
  fs.writeFileSync('scratch_diff_output', diff);
  console.log('Success');
} catch (err) {
  console.error(err);
  fs.writeFileSync('scratch_diff_error', err.stack || String(err));
}
